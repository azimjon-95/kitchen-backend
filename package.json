{
  "name": "clean-kitchen-backend",
  "private": true,
  "version": "13.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @clean-kitchen/server",
    "build": "npm run build -w @clean-kitchen/shared && npm run build -w @clean-kitchen/server",
    "typecheck": "npm run typecheck -w @clean-kitchen/shared && npm run typecheck -w @clean-kitchen/server",
    "start": "node apps/server/dist/index.js",
    "seed": "npm run seed -w @clean-kitchen/server",
    "seed:prod": "npm run seed:prod -w @clean-kitchen/server",
    "test": "npm test -w @clean-kitchen/server"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}