# Скопируйте в .env и заполните. Файл .env в git не попадает.
PORT=4000

# Адреса фронтендов через запятую (CORS). Для продакшена — https-адреса клиента.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
ADMIN_ORIGIN=http://localhost:5174

# MongoDB: локально или MongoDB Atlas (mongodb+srv://user:pass@cluster.mongodb.net/clean-kitchen)
MONGODB_URI=mongodb://127.0.0.1:27017/clean-kitchen

# Redis (необязательно): кэш списков, delta-sync и rate-limit. Без него сервер работает напрямую с MongoDB.
# REDIS_URL=redis://127.0.0.1:6379

# ───── Единая авторизация (multi-tenant, /api/v1) ─────
# Секреты — длинные случайные (минимум 32 символа):  openssl rand -hex 48. В продакшене без них сервер не стартует.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-0123456789
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Адреса клиента через запятую (CORS + проверка Origin для refresh-cookie)
APP_ORIGIN=http://localhost:5173
# Cookie: в продакшене Secure + SameSite=None (клиент и API на разных доменах). Для одного домена — COOKIE_SAMESITE=lax
# COOKIE_SAMESITE=lax
# Super Admin создаётся ОДИН раз при первом запуске; повторный запуск дубликатов не создаёт. После этого пароль из ENV можно убрать.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123
# Отключить старый однотенантный API (общий демо-каталог) в продакшене: LEGACY_API=off
# LEGACY_API=off

# (старый API) секрет JWT
JWT_SECRET=change-me-to-a-long-random-string

# Первый администратор создаётся при первом запуске, если такого email ещё нет
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Валюта отображения себестоимости (ISO 4217)
COST_CURRENCY=UZS

# Серверное распознавание речи (Whisper-совместимый API). Без ключа — клиент использует системное распознавание.
# Groq (быстро, есть бесплатный тариф): https://console.groq.com  |  OpenAI: STT_API_URL=https://api.openai.com/v1/audio/transcriptions, STT_MODEL=gpt-4o-transcribe
# STT_API_KEY=
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_MODEL=whisper-large-v3
