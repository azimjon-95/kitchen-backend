PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/clean-kitchen

# Generate a long random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Initial admin is created once on first startup if this email does not exist.
ADMIN_NAME=Restaurant Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Currency used for recipe cost display (ISO 4217)
COST_CURRENCY=UZS
